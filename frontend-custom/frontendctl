#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="/home/ubuntu/RAG_Weknora"
CUSTOM_ROOT="${PROJECT_ROOT}/frontend-custom"
ACTIVE_CONTAINER="WeKnora-frontend"
PREVIEW_CONTAINER="WeKnora-frontend-custom-preview"
NETWORK="weknora_v080_WeKnora-network"
ORIGINAL_SOURCE_IMAGE="wechatopenai/weknora-ui:0.8.0"
ORIGINAL_IMAGE="archive-intelligence-ui-original:0.8.0"
CUSTOM_IMAGE="archive-intelligence-ui:0.1.0"
BASE_IMAGE="archive-intelligence-ui-base:0.8.0"
PUBLIC_PORT="18180"
SMOKE_PORT="18183"

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
info() { printf '[frontendctl] %s\n' "$*"; }

image_exists() { docker image inspect "$1" >/dev/null 2>&1; }

ensure_original_image() {
  if ! image_exists "${ORIGINAL_IMAGE}"; then
    image_exists "${ORIGINAL_SOURCE_IMAGE}" || die "original image missing: ${ORIGINAL_SOURCE_IMAGE}"
    docker tag "${ORIGINAL_SOURCE_IMAGE}" "${ORIGINAL_IMAGE}"
  fi
  if ! image_exists "${BASE_IMAGE}"; then
    docker tag "${ORIGINAL_SOURCE_IMAGE}" "${BASE_IMAGE}"
  fi
}

run_frontend() {
  local image="$1" edition="$2"
  docker rm -f "${ACTIVE_CONTAINER}" >/dev/null 2>&1 || true
  docker run -d \
    --name "${ACTIVE_CONTAINER}" \
    --restart unless-stopped \
    --network "${NETWORK}" \
    -p "${PUBLIC_PORT}:80" \
    --label "com.yifang.frontend.edition=${edition}" \
    -e MAX_FILE_SIZE_MB=50 \
    -e MAX_SKILL_BUNDLE_SIZE_MB=256 \
    -e DEFAULT_LOCALE=zh-CN \
    -e APP_HOST=app \
    -e APP_PORT=8080 \
    -e APP_SCHEME=http \
    "${image}" >/dev/null

  local attempt
  for attempt in $(seq 1 30); do
    if curl -fsS "http://127.0.0.1:${PUBLIC_PORT}/" >/dev/null 2>&1; then
      info "active edition: ${edition}"
      return 0
    fi
    sleep 1
  done
  return 1
}

smoke_custom() {
  image_exists "${CUSTOM_IMAGE}" || die "custom image missing; run: $0 build custom"
  docker rm -f frontend-custom-smoke >/dev/null 2>&1 || true
  docker run -d --rm --name frontend-custom-smoke \
    --network "${NETWORK}" -p "127.0.0.1:${SMOKE_PORT}:80" \
    -e APP_HOST=app -e APP_PORT=8080 -e APP_SCHEME=http \
    "${CUSTOM_IMAGE}" >/dev/null
  local ok=0 attempt
  for attempt in $(seq 1 20); do
    if curl -fsS "http://127.0.0.1:${SMOKE_PORT}/" | grep -q '<title>档案智查</title>'; then
      ok=1
      break
    fi
    sleep 1
  done
  docker rm -f frontend-custom-smoke >/dev/null 2>&1 || true
  [[ "${ok}" == 1 ]] || die "custom image smoke test failed"
}

build_custom() {
  [[ -d "${CUSTOM_ROOT}" ]] || die "custom source missing: ${CUSTOM_ROOT}"
  ensure_original_image
  info "type-checking and building custom frontend"
  docker run --rm -v "${PROJECT_ROOT}:/work" -w /work/frontend-custom node:22-bookworm \
    sh -lc 'npm run type-check && npm run build'
  info "building offline runtime image"
  DOCKER_BUILDKIT=0 docker build -f "${CUSTOM_ROOT}/Dockerfile.local" \
    -t "${CUSTOM_IMAGE}" "${CUSTOM_ROOT}"
  smoke_custom
}

switch_original() {
  ensure_original_image
  run_frontend "${ORIGINAL_IMAGE}" original || die "original frontend failed to start"
}

switch_custom() {
  ensure_original_image
  [[ -d "${CUSTOM_ROOT}" ]] || { info "custom source is absent; falling back to original"; switch_original; return; }
  if ! image_exists "${CUSTOM_IMAGE}"; then
    info "custom image is absent; falling back to original"
    switch_original
    return
  fi
  smoke_custom
  if ! run_frontend "${CUSTOM_IMAGE}" custom; then
    info "custom frontend failed health check; restoring original"
    switch_original
    return 1
  fi
}

status() {
  if ! docker inspect "${ACTIVE_CONTAINER}" >/dev/null 2>&1; then
    echo "container: absent"
    return 1
  fi
  local edition image title
  edition="$(docker inspect -f '{{ index .Config.Labels "com.yifang.frontend.edition" }}' "${ACTIVE_CONTAINER}" 2>/dev/null || true)"
  image="$(docker inspect -f '{{.Config.Image}}' "${ACTIVE_CONTAINER}")"
  title="$(curl -fsS "http://127.0.0.1:${PUBLIC_PORT}/" 2>/dev/null | sed -n 's:.*<title>\([^<]*\)</title>.*:\1:p' || true)"
  printf 'container: %s\nedition: %s\nimage: %s\nhttp_title: %s\ncustom_source: %s\n' \
    "$(docker inspect -f '{{.State.Status}}' "${ACTIVE_CONTAINER}")" \
    "${edition:-unknown}" "${image}" "${title:-unavailable}" \
    "$([[ -d "${CUSTOM_ROOT}" ]] && echo present || echo absent)"
}

uninstall_custom() {
  local purge_source="${1:-}"
  switch_original
  docker rm -f "${PREVIEW_CONTAINER}" >/dev/null 2>&1 || true
  docker image rm "${CUSTOM_IMAGE}" >/dev/null 2>&1 || true
  if [[ "${purge_source}" == "--purge-source" ]]; then
    [[ "${CUSTOM_ROOT}" == "/home/ubuntu/RAG_Weknora/frontend-custom" ]] || die "refusing unsafe source path"
    rm -rf -- "${CUSTOM_ROOT}"
    info "custom source removed: ${CUSTOM_ROOT}"
  fi
  info "custom frontend uninstalled; original frontend is active"
}

usage() {
  cat <<EOF
Usage:
  $0 install
  $0 build custom
  $0 switch custom|original
  $0 status
  $0 uninstall custom [--purge-source]
EOF
}

case "${1:-}" in
  install) ensure_original_image; info "original frontend image locked as ${ORIGINAL_IMAGE}" ;;
  build) [[ "${2:-}" == custom ]] || die "only 'build custom' is supported"; build_custom ;;
  switch)
    case "${2:-}" in custom) switch_custom ;; original) switch_original ;; *) usage; exit 2 ;; esac
    ;;
  status) status ;;
  uninstall) [[ "${2:-}" == custom ]] || die "only 'uninstall custom' is supported"; uninstall_custom "${3:-}" ;;
  *) usage; exit 2 ;;
esac
