{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archive-intelligence:weknora-chunks-v1:manifest",
  "type": "object",
  "required": ["format", "package_id", "source_system", "dataset_id", "generation_id", "producer_commit", "generation_config", "counts", "files"],
  "properties": {
    "format": {"const": "weknora-chunks-v1"},
    "package_id": {"type": "string", "minLength": 1},
    "source_system": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "generation_id": {"type": "string", "minLength": 1},
    "producer_commit": {"type": "string"},
    "generation_config": {"type": "object"},
    "counts": {"type": "object", "required": ["documents", "chunks", "source_units"], "additionalProperties": {"type": "integer", "minimum": 0}},
    "files": {"type": "object", "minProperties": 3, "additionalProperties": {"type": "object", "required": ["sha256", "size"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 0}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
