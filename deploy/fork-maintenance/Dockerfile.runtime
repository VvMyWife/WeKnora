ARG RUNTIME_BASE=weknora-app:document-graph-20261019-195330
FROM ${RUNTIME_BASE}
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
COPY WeKnora /app/WeKnora
COPY migrations /app/migrations-next
RUN mv /app/migrations /app/migrations-before-ljc && mv /app/migrations-next /app/migrations
