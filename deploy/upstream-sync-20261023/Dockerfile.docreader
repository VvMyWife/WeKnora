ARG BASE_IMAGE=weknora-docreader:ljc-sync-base-20261023
FROM ${BASE_IMAGE}
USER root
ARG SOURCE_REVISION=working-tree
LABEL org.opencontainers.image.revision=${SOURCE_REVISION} ljc.operation=upstream-20261023
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple \
    UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright
WORKDIR /app
COPY docreader/pyproject.toml docreader/uv.lock ./
# Export locked versions without registry URLs; resolve artifacts through the
# persistent China mirror configuration instead of the upstream PyPI lock URLs.
RUN --mount=type=cache,id=ljc-docreader-uv,target=/root/.cache/uv \
    uv export --frozen --no-dev --no-emit-project --no-hashes > /tmp/docreader-locked.txt \
    && uv pip sync --python /app/.venv/bin/python /tmp/docreader-locked.txt
COPY docreader /app/docreader
ENTRYPOINT ["/app/.venv/bin/python", "-m", "docreader.container_entrypoint"]
CMD ["/app/.venv/bin/python", "-m", "docreader.main"]
