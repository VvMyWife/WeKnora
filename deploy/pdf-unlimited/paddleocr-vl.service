[Unit]
Description=PaddleOCR VL full-document serving (unlimited pages)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=/data/ocr-services/paddleocr-3.6-vl1.6/start-vl.sh
WorkingDirectory=/data/ocr-services/paddleocr-3.6-vl1.6
Restart=on-failure
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=60
StandardOutput=append:/data/ocr-services/paddleocr-3.6-vl1.6/logs/vl-9960.log
StandardError=append:/data/ocr-services/paddleocr-3.6-vl1.6/logs/vl-9960.log
[Install]
WantedBy=multi-user.target
