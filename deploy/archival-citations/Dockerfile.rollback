# Retain the old binary and all old runtime customizations, but keep the new
# migration source available: an old migrator must still recognize version 94.
ARG RUNTIME_BASE
FROM ${RUNTIME_BASE}
COPY migrations/ /app/migrations/
RUN find /app/migrations -type d -exec chmod 0755 {} + \
 && find /app/migrations -type f -exec chmod 0644 {} +
